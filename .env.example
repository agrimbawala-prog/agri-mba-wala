# Public URL used in canonical URLs, sitemaps, and social previews.
NEXT_PUBLIC_SITE_URL=https://agrimbawala.example
# Digits only, including country code. Replace before launch.
NEXT_PUBLIC_WHATSAPP_NUMBER=919172115522

# Local development uses SQLite. Vercel's filesystem is ephemeral, so use Supabase
# in production by supplying both variables below.
SUBMISSIONS_DB_PATH=./data/submissions.sqlite
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Required to protect /admin. Generate a long, unique session secret.
ADMIN_USERNAME=replace-me
ADMIN_PASSWORD=replace-me
ADMIN_SESSION_SECRET=replace-with-a-long-random-value
